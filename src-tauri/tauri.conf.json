{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fulgurite",
  "version": "0.1.0",
  "identifier": "br.net.fragmenta.fulgurite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fulgurite",
        "width": 800,
        "height": 632,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "options",
        "width": 800,
        "height": 632,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
